{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend: install deps",
      "type": "shell",
      "command": "poetry install && .venv/Scripts/pip install --no-deps -e ./vendor/trainingpeaks-mcp",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "backend: setup auth",
      "type": "shell",
      "command": "bash scripts/setup-auth.sh",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "backend: test connection",
      "type": "shell",
      "command": ".venv/Scripts/python scripts/test_connection.py",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "backend: run app",
      "type": "shell",
      "command": ".venv/Scripts/python scripts/op_run.py poetry run uvicorn app.main:app --reload --port 8000",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "group": "none",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "servers"
      },
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "INFO:.*Uvicorn running",
          "endsPattern": "Application startup complete"
        }
      }
    },
    {
      "label": "backend: build docs",
      "type": "shell",
      "command": "poetry run pdoc -d google app -o docs",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "backend: serve docs",
      "type": "shell",
      "command": "poetry run pdoc -d google app",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "group": "none",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "backend: run all tests",
      "type": "shell",
      "command": ".venv/Scripts/python scripts/op_run.py poetry run pytest",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "tests"
      }
    },
    {
      "label": "backend: run unit tests",
      "type": "shell",
      "command": "poetry run pytest tests/unit/ -v",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "tests"
      }
    },
    {
      "label": "backend: run integration tests",
      "type": "shell",
      "command": ".venv/Scripts/python scripts/op_run.py poetry run pytest tests/integration/ -v",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "tests"
      }
    },
    {
      "label": "frontend: install deps",
      "type": "shell",
      "command": "npm install",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "frontend: run",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "group": "none",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "servers"
      },
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "ready in"
        }
      }
    },
    {
      "label": "frontend: build",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "docker: up",
      "type": "shell",
      "command": "backend/.venv/Scripts/python backend/scripts/op_run.py docker compose up --build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "none",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "docker: down",
      "type": "shell",
      "command": "docker compose down",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "app: run",
      "dependsOn": ["backend: run app", "frontend: run"],
      "dependsOrder": "parallel",
      "group": "none",
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "app: install all deps",
      "dependsOn": ["backend: install deps", "frontend: install deps"],
      "dependsOrder": "parallel",
      "group": "build"
    }
  ]
}
